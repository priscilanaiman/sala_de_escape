@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
  <h1>Bienvenido a la Sala de Escape</h1>
  <p>Prepárate para una experiencia emocionante. ¿Estás listo para comenzar?</p>
  <p style="color: red;">@ViewBag.Mensaje</p>
  <div style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center;margin-top:1rem">
    <a href="@Url.Action("IngresarNombre", "Home")" class="btn">Comenzar</a>
    <a href="@Url.Action("Tutorial", "Home")" class="btn secondary">Ver Tutorial</a>
    <a href="@Url.Action("Story", "Home")" class="btn secondary">Ver Historia</a>
    <a href="@Url.Action("RetomarPartida", "Home")" class="btn secondary">Retomar partida</a>
  </div>
</div>
