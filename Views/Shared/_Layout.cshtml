<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - sala_de_escape</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sala_de_escape.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:.5rem 0">
                <a class="app-title" asp-area="" asp-controller="Home" asp-action="Index">Sala de Escape</a>
                <nav>
                    <a class="muted" asp-area="" asp-controller="Home" asp-action="Index" style="margin-right:.75rem">Inicio</a>
                    <a class="muted" asp-area="" asp-controller="Home" asp-action="Tutorial">Tutorial</a>
                </nav>
            </div>
        </div>
    </header>

    <div class="site-wrapper" style="display:flex;align-items:center;justify-content:center;padding:2rem 0;">
        <div class="container">
            <main role="main">
                <div class="card" style="max-width:var(--max-width);margin:0 auto;padding:1.25rem;background:linear-gradient(180deg,rgba(14,33,51,0.6),rgba(6,12,20,0.6));">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <footer class="app-footer">
        <div class="container text-center">
            &copy; 2026 - Sala de Escape
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
